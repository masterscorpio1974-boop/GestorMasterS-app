name: Build GESTOR ROJO Capacitor OFFGRID
on:
  push:
    branches: [ main ]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node 20
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Setup Java 21
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 21

      - name: Clean old builds
        run: rm -rf android node_modules package-lock.json

      - name: Install dependencies
        run: npm install

      - name: Add Android platform
        run: npx @capacitor/cli add android

      - name: Sync web to Android
        run: npx @capacitor/cli sync android

      - name: Build APK ROJO DEBUG
        run: |
          cd android
          chmod +x gradlew
          ./gradlew assembleDebug

      - name: Upload APK ROJO OFFGRID
        uses: actions/upload-artifact@v4
        with:
          name: GestorMasterS-ROJO-APK-OFFGRID
          path: android/app/build/outputs/apk/debug/app-debug.apk
